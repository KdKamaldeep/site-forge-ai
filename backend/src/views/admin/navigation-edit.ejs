<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Navigation - MicroSite Empire AI</title>
    <link rel="stylesheet" href="/admin/styles.css">
    <style>
        .menu-item {
            display: flex;
            gap: 10px;
            align-items: center;
            padding: 10px;
            background: #f9fafb;
            border-radius: 6px;
            margin-bottom: 10px;
        }
        .menu-item input {
            flex: 1;
        }
        .btn-remove {
            background: #ef4444;
            color: white;
            border: none;
            padding: 6px 12px;
            border-radius: 4px;
            cursor: pointer;
        }
        .btn-remove:hover {
            background: #dc2626;
        }
    </style>
</head>
<body>
    <div class="sidebar">
        <div class="sidebar-header">
            <h2>MicroSite CMS</h2>
        </div>
        
        <div class="sidebar-search">
            <input type="text" placeholder="🔍 Search..." class="search-input">
        </div>
        
        <div class="sidebar-user">
            <div class="user-avatar">
                <span>A</span>
            </div>
            <div class="user-info">
                <div class="user-name">Admin</div>
                <div class="user-id">ID: 000000</div>
            </div>
        </div>
        
        <div class="sidebar-section">
            <div class="section-title">DASHBOARDS</div>
            <ul class="sidebar-nav">
                <li><a href="/admin/dashboard">📊 Dashboard</a></li>
            </ul>
        </div>
        
        <div class="sidebar-section">
            <div class="section-title">MANAGEMENT</div>
            <ul class="sidebar-nav">
                <li><a href="/admin/tenants">🏢 Tenants</a></li>
                <li><a href="/admin/pages">📄 Pages</a></li>
                <li><a href="/admin/themes">🎨 Themes</a></li>
                <li><a href="/admin/navigation" class="active">🧭 Navigation</a></li>
            </ul>
        </div>
        
        <% if (typeof allTenants !== 'undefined' && allTenants && allTenants.length > 0) { %>
        <div class="sidebar-tenants">
            <div class="sidebar-tenants-title">TENANTS</div>
            <% allTenants.slice(0, 5).forEach(t => { %>
                <div class="tenant-item <%= tenantId === t._id.toString() ? 'active' : '' %>" onclick="window.location.href='/admin/tenants/edit/<%= t._id %>'">
                    <span class="tenant-dot"></span>
                    <span class="tenant-name"><%= t.name %></span>
                </div>
            <% }); %>
            <% if (allTenants.length > 5) { %>
                <div class="tenant-item" onclick="window.location.href='/admin/tenants'" style="justify-content: center; color: rgba(255, 255, 255, 0.5); font-size: 11px;">
                    +<%= allTenants.length - 5 %> more
                </div>
            <% } %>
        </div>
        <% } %>
    </div>

    <div class="main-content">
        <div class="top-header">
            <div class="breadcrumb">
                <span>Dashboards</span>
                <span class="separator">></span>
                <span class="current">Edit Navigation</span>
            </div>
            <div class="header-actions">
                <button class="icon-btn" title="Notifications">
                    <span>🔔</span>
                    <span class="badge">3</span>
                </button>
                <button class="icon-btn" title="Settings">
                    <span>⚙️</span>
                </button>
                <form method="POST" action="/admin/logout" style="display: inline;">
                    <button type="submit" class="btn btn-sm btn-logout">Logout</button>
                </form>
            </div>
        </div>
        
        <div class="page-header">
            <h1>Edit Navigation - <%= tenant.name %></h1>
        </div>

        <div class="form-container">
            <form method="POST" action="/admin/navigation/update/<%= tenantId %>" id="navigationForm">
                <div class="form-group">
                    <label>Logo URL</label>
                    <input type="url" name="logo" value="<%= navigation.logo || '' %>" placeholder="https://example.com/logo.png">
                    <% if (navigation.logo) { %>
                        <div style="margin-top: 10px;">
                            <img src="<%= navigation.logo %>" alt="Current Logo" style="max-width: 100px; max-height: 100px; border-radius: 4px; border: 1px solid #e5e7eb;">
                        </div>
                    <% } %>
                    <small style="color: #6b7280; font-size: 12px; margin-top: 4px; display: block;">Logo URL for header/navigation</small>
                </div>

                <fieldset style="border: 1px solid #e5e7eb; border-radius: 8px; padding: 20px; margin: 20px 0;">
                    <legend style="font-weight: 600; padding: 0 8px;">Menu Items</legend>
                    <div id="menuItems">
                        <% if (navigation.menu && navigation.menu.length > 0) { %>
                            <% navigation.menu.forEach((item, index) => { %>
                                <div class="menu-item" data-index="<%= index %>">
                                    <input type="text" name="menuItems[]" value='<%= JSON.stringify(item) %>' placeholder='{"label": "Home", "slug": "home"}' required>
                                    <button type="button" class="btn-remove" onclick="removeMenuItem(this)">Remove</button>
                                </div>
                            <% }); %>
                        <% } else { %>
                            <div class="menu-item" data-index="0">
                                <input type="text" name="menuItems[]" placeholder='{"label": "Home", "slug": "home"}' required>
                                <button type="button" class="btn-remove" onclick="removeMenuItem(this)">Remove</button>
                            </div>
                        <% } %>
                    </div>
                    <button type="button" onclick="addMenuItem()" class="btn btn-sm" style="background: #10b981; color: white; margin-top: 10px;">+ Add Menu Item</button>
                    <small style="color: #6b7280; font-size: 12px; margin-top: 8px; display: block;">Format: {"label": "Menu Label", "slug": "page-slug"}</small>
                    
                    <% if (pages && pages.length > 0) { %>
                        <div style="margin-top: 15px; padding: 10px; background: #f3f4f6; border-radius: 6px;">
                            <strong style="font-size: 12px; color: #374151;">Quick Add from Pages:</strong>
                            <div style="display: flex; flex-wrap: wrap; gap: 8px; margin-top: 8px;">
                                <% pages.forEach(page => { %>
                                    <button type="button" onclick='addPageToMenu("<%= page.title %>", "<%= page.slug %>")' class="btn btn-sm" style="background: #3b82f6; color: white; font-size: 11px; padding: 4px 8px;">
                                        + <%= page.title %>
                                    </button>
                                <% }); %>
                            </div>
                        </div>
                    <% } %>
                </fieldset>

                <fieldset style="border: 1px solid #e5e7eb; border-radius: 8px; padding: 20px; margin: 20px 0;">
                    <legend style="font-weight: 600; padding: 0 8px;">Call-to-Action Button</legend>
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px;">
                        <div class="form-group">
                            <label>CTA Label</label>
                            <input type="text" name="ctaLabel" value="<%= navigation.cta && navigation.cta.label ? navigation.cta.label : '' %>" placeholder="Get Started">
                        </div>
                        <div class="form-group">
                            <label>CTA URL</label>
                            <input type="url" name="ctaUrl" value="<%= navigation.cta && navigation.cta.url ? navigation.cta.url : '' %>" placeholder="https://example.com/contact">
                        </div>
                    </div>
                </fieldset>

                <div style="display: flex; gap: 10px; margin-top: 30px;">
                    <button type="submit" class="btn btn-primary">Save Navigation</button>
                    <a href="/admin/navigation" class="btn" style="background: #6b7280; color: white; text-decoration: none;">Cancel</a>
                </div>
            </form>
        </div>
    </div>
    
    <footer class="admin-footer">
        <div>
            <span>© 2024 MicroSite Empire AI. All rights reserved.</span>
        </div>
        <div class="footer-links">
            <a href="/admin/dashboard">Dashboard</a>
            <a href="/api-docs" target="_blank">API Docs</a>
            <a href="#" onclick="alert('Version 1.0.0'); return false;">Version</a>
        </div>
    </footer>

    <script>
        let menuItemIndex = <%= navigation.menu ? navigation.menu.length : 1 %>;

        function addMenuItem() {
            const container = document.getElementById('menuItems');
            const div = document.createElement('div');
            div.className = 'menu-item';
            div.setAttribute('data-index', menuItemIndex);
            div.innerHTML = `
                <input type="text" name="menuItems[]" placeholder='{"label": "Menu Label", "slug": "page-slug"}' required>
                <button type="button" class="btn-remove" onclick="removeMenuItem(this)">Remove</button>
            `;
            container.appendChild(div);
            menuItemIndex++;
        }

        function removeMenuItem(btn) {
            const container = document.getElementById('menuItems');
            if (container.children.length > 1) {
                btn.parentElement.remove();
            } else {
                alert('At least one menu item is required');
            }
        }

        function addPageToMenu(label, slug) {
            const container = document.getElementById('menuItems');
            const div = document.createElement('div');
            div.className = 'menu-item';
            div.setAttribute('data-index', menuItemIndex);
            const menuItem = JSON.stringify({ label: label, slug: slug });
            div.innerHTML = `
                <input type="text" name="menuItems[]" value='${menuItem.replace(/'/g, "&apos;")}' required>
                <button type="button" class="btn-remove" onclick="removeMenuItem(this)">Remove</button>
            `;
            container.appendChild(div);
            menuItemIndex++;
        }

        // Validate menu items on form submit
        document.getElementById('navigationForm').addEventListener('submit', function(e) {
            const menuInputs = document.querySelectorAll('input[name="menuItems[]"]');
            let valid = true;
            
            menuInputs.forEach(input => {
                try {
                    const item = JSON.parse(input.value);
                    if (!item.label || !item.slug) {
                        valid = false;
                        input.style.borderColor = '#ef4444';
                    } else {
                        input.style.borderColor = '';
                    }
                } catch (err) {
                    valid = false;
                    input.style.borderColor = '#ef4444';
                }
            });

            if (!valid) {
                e.preventDefault();
                alert('Please ensure all menu items are valid JSON with "label" and "slug" fields');
            }
        });
    </script>
</body>
</html>

