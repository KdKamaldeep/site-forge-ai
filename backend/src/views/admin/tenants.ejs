<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Tenants - MicroSite Empire AI</title>
    <link rel="stylesheet" href="/admin/styles.css">
</head>
<body>
    <div class="sidebar">
        <div class="sidebar-header">
            <h2>MicroSite CMS</h2>
        </div>
        
        <div class="sidebar-search">
            <input type="text" placeholder="🔍 Search..." class="search-input">
        </div>
        
        <div class="sidebar-user">
            <div class="user-avatar">
                <span>A</span>
            </div>
            <div class="user-info">
                <div class="user-name">Admin</div>
                <div class="user-id">ID: 000000</div>
            </div>
        </div>
        
        <div class="sidebar-section">
            <div class="section-title">DASHBOARDS</div>
            <ul class="sidebar-nav">
                <li><a href="/admin/dashboard">📊 Dashboard</a></li>
            </ul>
        </div>
        
        <div class="sidebar-section">
            <div class="section-title">MANAGEMENT</div>
            <ul class="sidebar-nav">
                <li><a href="/admin/tenants" class="active">🏢 Tenants</a></li>
                <li><a href="/admin/pages">📄 Pages</a></li>
                <li><a href="/admin/themes">🎨 Themes</a></li>
                <li><a href="/admin/navigation">🧭 Navigation</a></li>
            </ul>
        </div>
        
        <% if (typeof allTenants !== 'undefined' && allTenants && allTenants.length > 0) { %>
        <div class="sidebar-tenants">
            <div class="sidebar-tenants-title">TENANTS</div>
            <% allTenants.slice(0, 5).forEach(tenant => { %>
                <div class="tenant-item <%= typeof activeTenantId !== 'undefined' && activeTenantId === tenant._id.toString() ? 'active' : '' %>" onclick="window.location.href='/admin/tenants/edit/<%= tenant._id %>'">
                    <span class="tenant-dot"></span>
                    <span class="tenant-name"><%= tenant.name %></span>
                </div>
            <% }); %>
            <% if (allTenants.length > 5) { %>
                <div class="tenant-item" onclick="window.location.href='/admin/tenants'" style="justify-content: center; color: rgba(255, 255, 255, 0.5); font-size: 11px;">
                    +<%= allTenants.length - 5 %> more
                </div>
            <% } %>
        </div>
        <% } %>
    </div>

    <div class="main-content">
        <div class="top-header">
            <div class="breadcrumb">
                <span>Dashboards</span>
                <span class="separator">></span>
                <span class="current">Tenants</span>
            </div>
            <div class="header-actions">
                <button class="icon-btn" title="Notifications">
                    <span>🔔</span>
                    <span class="badge">3</span>
                </button>
                <button class="icon-btn" title="Settings">
                    <span>⚙️</span>
                </button>
                <button class="icon-btn" title="Messages">
                    <span>💬</span>
                    <span class="badge">1</span>
                </button>
                <form method="POST" action="/admin/logout" style="display: inline;">
                    <button type="submit" class="btn btn-sm btn-logout">Logout</button>
                </form>
            </div>
        </div>
        
        <div class="page-header">
            <h1>Manage Tenants</h1>
        </div>

        <% if (typeof success !== 'undefined' && success) { %>
            <div class="alert alert-success" style="background: #d4edda; color: #155724; padding: 12px; border-radius: 6px; margin-bottom: 20px;">
                <%= success %>
            </div>
        <% } %>

        <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-error" style="background: #f8d7da; color: #721c24; padding: 12px; border-radius: 6px; margin-bottom: 20px;">
                <%= error %>
            </div>
        <% } %>

        <div class="table-container">
            <div class="table-header">
                <h2>All Tenants</h2>
                <a href="/admin/tenants/new" class="btn btn-primary">+ New Tenant</a>
            </div>
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Domain</th>
                        <th>Layout Style</th>
                        <th>Analytics</th>
                        <th>Created</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (tenants.length > 0) { %>
                        <% tenants.forEach(tenant => { %>
                            <tr>
                                <td><strong><%= tenant.name %></strong></td>
                                <td><code><%= tenant.domain %></code></td>
                                <td>
                                    <% if (tenant.layoutStyle) { %>
                                        <span style="background: #667eea; color: white; padding: 4px 8px; border-radius: 4px; font-size: 11px; font-weight: 600;">
                                            <%= tenant.layoutStyle.replace(/([A-Z])/g, ' $1').trim() %>
                                        </span>
                                    <% } else { %>
                                        <span style="color: #9ca3af; font-size: 12px;">Auto</span>
                                    <% } %>
                                </td>
                                <td>
                                    <div style="display: flex; flex-direction: column; gap: 4px;">
                                        <% if (tenant.googleAnalyticsId) { %>
                                            <span style="background: #10b981; color: white; padding: 2px 6px; border-radius: 3px; font-size: 10px;">GA4</span>
                                        <% } %>
                                        <% if (tenant.adsenseId) { %>
                                            <span style="background: #3b82f6; color: white; padding: 2px 6px; border-radius: 3px; font-size: 10px;">AdSense</span>
                                        <% } %>
                                        <% if (!tenant.googleAnalyticsId && !tenant.adsenseId) { %>
                                            <span style="color: #9ca3af; font-size: 11px;">—</span>
                                        <% } %>
                                    </div>
                                </td>
                                <td><%= new Date(tenant.createdAt).toLocaleDateString() %></td>
                                <td>
                                    <div class="action-buttons" style="display: flex !important; gap: 8px !important; align-items: center !important; visibility: visible !important;">
                                        <a href="/admin/tenants/edit/<%= tenant._id %>" class="btn btn-sm btn-edit" title="Edit Tenant" style="display: inline-flex !important; visibility: visible !important; opacity: 1 !important; padding: 6px 10px !important; background: #10b981 !important; color: white !important; border-radius: 6px !important; text-decoration: none !important; font-size: 12px !important;">
                                            <span style="font-size: 14px;">✏️</span> Edit
                                        </a>
                                        <form method="POST" action="/admin/tenants/delete/<%= tenant._id %>" style="display: inline !important; margin: 0 !important; visibility: visible !important;" onsubmit="return confirm('Are you sure you want to delete this tenant? This will also delete all associated pages.');">
                                            <button type="submit" class="btn btn-sm btn-delete" title="Delete Tenant" style="display: inline-flex !important; visibility: visible !important; opacity: 1 !important; padding: 6px 10px !important; background: #ef4444 !important; color: white !important; border-radius: 6px !important; border: none !important; cursor: pointer !important; font-size: 12px !important;">
                                                <span style="font-size: 14px;">🗑️</span> Delete
                                            </button>
                                        </form>
                                        <a href="https://<%= tenant.domain %>" target="_blank" class="btn btn-sm" style="display: inline-flex !important; visibility: visible !important; opacity: 1 !important; padding: 6px 10px !important; background: #3b82f6 !important; color: white !important; border-radius: 6px !important; text-decoration: none !important; font-size: 12px !important;" title="View Site">
                                            <span style="font-size: 14px;">👁️</span> View
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        <% }); %>
                    <% } else { %>
                        <tr><td colspan="6" class="empty-state">No tenants found. Create your first tenant to get started!</td></tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
    
    <footer class="admin-footer">
        <div>
            <span>© 2024 MicroSite Empire AI. All rights reserved.</span>
        </div>
        <div class="footer-links">
            <a href="/admin/dashboard">Dashboard</a>
            <a href="/api-docs" target="_blank">API Docs</a>
            <a href="#" onclick="alert('Version 1.0.0'); return false;">Version</a>
        </div>
    </footer>
</body>
</html>
