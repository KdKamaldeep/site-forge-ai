<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= theme ? 'Edit Theme' : 'Create Theme' %> - MicroSite Empire AI</title>
    <link rel="stylesheet" href="/admin/styles.css">
</head>
<body>
    <div class="sidebar">
        <div class="sidebar-header">
            <h2>MicroSite CMS</h2>
        </div>
        <ul class="sidebar-nav">
            <li><a href="/admin/dashboard">Dashboard</a></li>
            <li><a href="/admin/tenants">Tenants</a></li>
            <li><a href="/admin/pages">Pages</a></li>
            <li><a href="/admin/themes" class="active">Themes</a></li>
            <li><a href="/admin/navigation">🧭 Navigation</a></li>
        </ul>
    </div>

    <div class="main-content">
        <div class="header">
            <h1><%= theme ? 'Edit Theme' : 'Create Theme' %></h1>
            <form method="POST" action="/admin/logout" style="display: inline;">
                <button type="submit" class="btn-logout">Logout</button>
            </form>
        </div>

        <form method="POST" action="<%= theme ? '/admin/themes/update/' + theme._id : '/admin/themes' %>" style="max-width: 600px;">
            <div class="form-group">
                <label>Name</label>
                <input type="text" name="name" value="<%= theme ? theme.name : '' %>" required>
            </div>
            <div class="form-group">
                <label>Description</label>
                <textarea name="description" rows="3"><%= theme ? theme.description : '' %></textarea>
            </div>
            <div class="form-actions">
                <a href="/admin/themes" class="btn-secondary" style="text-decoration: none; display: inline-block;">Cancel</a>
                <button type="submit" class="btn-primary">Save</button>
            </div>
        </form>
    </div>
</body>
</html>
