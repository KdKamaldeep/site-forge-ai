<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Themes - MicroSite Empire AI</title>
    <link rel="stylesheet" href="/admin/styles.css">
</head>
<body>
    <div class="sidebar">
        <div class="sidebar-header">
            <h2>MicroSite CMS</h2>
        </div>
        
        <div class="sidebar-search">
            <input type="text" placeholder="🔍 Search..." class="search-input">
        </div>
        
        <div class="sidebar-user">
            <div class="user-avatar">
                <span>A</span>
            </div>
            <div class="user-info">
                <div class="user-name">Admin</div>
                <div class="user-id">ID: 000000</div>
            </div>
        </div>
        
        <div class="sidebar-section">
            <div class="section-title">DASHBOARDS</div>
            <ul class="sidebar-nav">
                <li><a href="/admin/dashboard">📊 Dashboard</a></li>
            </ul>
        </div>
        
        <div class="sidebar-section">
            <div class="section-title">MANAGEMENT</div>
            <ul class="sidebar-nav">
                <li><a href="/admin/tenants">🏢 Tenants</a></li>
                <li><a href="/admin/pages">📄 Pages</a></li>
                <li><a href="/admin/themes" class="active">🎨 Themes</a></li>
                <li><a href="/admin/navigation">🧭 Navigation</a></li>
            </ul>
        </div>
        
        <% if (typeof tenants !== 'undefined' && tenants && tenants.length > 0) { %>
        <div class="sidebar-tenants">
            <div class="sidebar-tenants-title">TENANTS</div>
            <% tenants.slice(0, 5).forEach(tenant => { %>
                <div class="tenant-item" onclick="window.location.href='/admin/tenants/edit/<%= tenant._id %>'">
                    <span class="tenant-dot"></span>
                    <span class="tenant-name"><%= tenant.name %></span>
                </div>
            <% }); %>
            <% if (tenants.length > 5) { %>
                <div class="tenant-item" onclick="window.location.href='/admin/tenants'" style="justify-content: center; color: rgba(255, 255, 255, 0.5); font-size: 11px;">
                    +<%= tenants.length - 5 %> more
                </div>
            <% } %>
        </div>
        <% } %>
    </div>

    <div class="main-content">
        <div class="top-header">
            <div class="breadcrumb">
                <span>Dashboards</span>
                <span class="separator">></span>
                <span class="current">Themes</span>
            </div>
            <div class="header-actions">
                <button class="icon-btn" title="Notifications">
                    <span>🔔</span>
                    <span class="badge">3</span>
                </button>
                <button class="icon-btn" title="Settings">
                    <span>⚙️</span>
                </button>
                <form method="POST" action="/admin/logout" style="display: inline;">
                    <button type="submit" class="btn btn-sm btn-logout">Logout</button>
                </form>
            </div>
        </div>
        
        <div class="page-header">
            <h1>Manage Themes</h1>
        </div>

        <% if (typeof success !== 'undefined' && success) { %>
            <div class="alert alert-success" style="background: #d4edda; color: #155724; padding: 12px; border-radius: 6px; margin-bottom: 20px;">
                <%= success %>
            </div>
        <% } %>

        <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-error" style="background: #f8d7da; color: #721c24; padding: 12px; border-radius: 6px; margin-bottom: 20px;">
                <%= error %>
            </div>
        <% } %>

        <div class="table-container">
            <div class="table-header">
                <h2>All Themes</h2>
                <a href="/admin/themes/new" class="btn btn-primary">+ New Theme</a>
            </div>
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Description</th>
                        <th>Created</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (themes.length > 0) { %>
                        <% themes.forEach(theme => { %>
                            <tr>
                                <td><strong><%= theme.name %></strong></td>
                                <td><%= theme.description || '<span style="color: #999;">No description</span>' %></td>
                                <td><%= new Date(theme.createdAt).toLocaleDateString() %></td>
                                <td>
                                    <div class="action-buttons">
                                        <a href="/admin/themes/edit/<%= theme._id %>" class="btn btn-sm btn-edit" title="Edit Theme">
                                            <span style="font-size: 14px;">✏️</span> Edit
                                        </a>
                                        <form method="POST" action="/admin/themes/delete/<%= theme._id %>" style="display: inline;" onsubmit="return confirm('Are you sure you want to delete this theme?');">
                                            <button type="submit" class="btn btn-sm btn-delete" title="Delete Theme">
                                                <span style="font-size: 14px;">🗑️</span> Delete
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        <% }); %>
                    <% } else { %>
                        <tr><td colspan="4" class="empty-state">No themes found. Create your first theme to get started!</td></tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
    
    <footer class="admin-footer">
        <div>
            <span>© 2024 MicroSite Empire AI. All rights reserved.</span>
        </div>
        <div class="footer-links">
            <a href="/admin/dashboard">Dashboard</a>
            <a href="/api-docs" target="_blank">API Docs</a>
            <a href="#" onclick="alert('Version 1.0.0'); return false;">Version</a>
        </div>
    </footer>
</body>
</html>
