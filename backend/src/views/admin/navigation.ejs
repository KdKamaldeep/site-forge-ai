<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Navigation - MicroSite Empire AI</title>
    <link rel="stylesheet" href="/admin/styles.css">
</head>
<body>
    <div class="sidebar">
        <div class="sidebar-header">
            <h2>MicroSite CMS</h2>
        </div>
        
        <div class="sidebar-search">
            <input type="text" placeholder="🔍 Search..." class="search-input">
        </div>
        
        <div class="sidebar-user">
            <div class="user-avatar">
                <span>A</span>
            </div>
            <div class="user-info">
                <div class="user-name">Admin</div>
                <div class="user-id">ID: 000000</div>
            </div>
        </div>
        
        <div class="sidebar-section">
            <div class="section-title">DASHBOARDS</div>
            <ul class="sidebar-nav">
                <li><a href="/admin/dashboard">📊 Dashboard</a></li>
            </ul>
        </div>
        
        <div class="sidebar-section">
            <div class="section-title">MANAGEMENT</div>
            <ul class="sidebar-nav">
                <li><a href="/admin/tenants">🏢 Tenants</a></li>
                <li><a href="/admin/pages">📄 Pages</a></li>
                <li><a href="/admin/themes">🎨 Themes</a></li>
                <li><a href="/admin/navigation" class="active">🧭 Navigation</a></li>
            </ul>
        </div>
        
        <% if (typeof allTenants !== 'undefined' && allTenants && allTenants.length > 0) { %>
        <div class="sidebar-tenants">
            <div class="sidebar-tenants-title">TENANTS</div>
            <% allTenants.slice(0, 5).forEach(tenant => { %>
                <div class="tenant-item" onclick="window.location.href='/admin/tenants/edit/<%= tenant._id %>'">
                    <span class="tenant-dot"></span>
                    <span class="tenant-name"><%= tenant.name %></span>
                </div>
            <% }); %>
            <% if (allTenants.length > 5) { %>
                <div class="tenant-item" onclick="window.location.href='/admin/tenants'" style="justify-content: center; color: rgba(255, 255, 255, 0.5); font-size: 11px;">
                    +<%= allTenants.length - 5 %> more
                </div>
            <% } %>
        </div>
        <% } %>
    </div>

    <div class="main-content">
        <div class="top-header">
            <div class="breadcrumb">
                <span>Dashboards</span>
                <span class="separator">></span>
                <span class="current">Navigation</span>
            </div>
            <div class="header-actions">
                <button class="icon-btn" title="Notifications">
                    <span>🔔</span>
                    <span class="badge">3</span>
                </button>
                <button class="icon-btn" title="Settings">
                    <span>⚙️</span>
                </button>
                <button class="icon-btn" title="Messages">
                    <span>💬</span>
                    <span class="badge">1</span>
                </button>
                <form method="POST" action="/admin/logout" style="display: inline;">
                    <button type="submit" class="btn btn-sm btn-logout">Logout</button>
                </form>
            </div>
        </div>
        
        <div class="page-header">
            <h1>Manage Navigation</h1>
        </div>

        <% if (typeof success !== 'undefined' && success) { %>
            <div class="alert alert-success" style="background: #d4edda; color: #155724; padding: 12px; border-radius: 6px; margin-bottom: 20px;">
                <%= success %>
            </div>
        <% } %>

        <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-error" style="background: #f8d7da; color: #721c24; padding: 12px; border-radius: 6px; margin-bottom: 20px;">
                <%= error %>
            </div>
        <% } %>

        <div class="table-container">
            <div class="table-header">
                <h2>All Navigation Configurations</h2>
                <div class="flex gap-2">
                    <form method="GET" action="/admin/navigation" style="display: inline;">
                        <select name="tenantId" onchange="this.form.submit()" class="form-group" style="margin: 0; padding: 8px 12px; border-radius: 6px; border: 2px solid var(--gray-border);">
                            <option value="">All Tenants</option>
                            <% tenants.forEach(t => { %>
                                <option value="<%= t._id %>" <%= selectedTenantId === t._id.toString() ? 'selected' : '' %>>
                                    <%= t.name %> (<%= t.domain %>)
                                </option>
                            <% }); %>
                        </select>
                    </form>
                </div>
            </div>
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Tenant</th>
                        <th>Logo</th>
                        <th>Menu Items</th>
                        <th>CTA</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (navigations.length > 0) { %>
                        <% navigations.forEach(nav => { %>
                            <tr>
                                <td><strong><%= nav.tenantName %></strong><br><small style="color: #6b7280;"><%= nav.tenantDomain %></small></td>
                                <td>
                                    <% if (nav.logo) { %>
                                        <img src="<%= nav.logo %>" alt="Logo" style="max-width: 50px; max-height: 50px; border-radius: 4px;">
                                    <% } else { %>
                                        <span style="color: #9ca3af;">—</span>
                                    <% } %>
                                </td>
                                <td>
                                    <% if (nav.menu && nav.menu.length > 0) { %>
                                        <div style="display: flex; flex-wrap: wrap; gap: 4px;">
                                            <% nav.menu.forEach(item => { %>
                                                <span style="background: #e5e7eb; color: #374151; padding: 2px 8px; border-radius: 4px; font-size: 11px;">
                                                    <%= item.label %>
                                                </span>
                                            <% }); %>
                                        </div>
                                    <% } else { %>
                                        <span style="color: #9ca3af;">No menu items</span>
                                    <% } %>
                                </td>
                                <td>
                                    <% if (nav.cta && nav.cta.label) { %>
                                        <span style="background: #3b82f6; color: white; padding: 4px 8px; border-radius: 4px; font-size: 11px;">
                                            <%= nav.cta.label %>
                                        </span>
                                    <% } else { %>
                                        <span style="color: #9ca3af;">—</span>
                                    <% } %>
                                </td>
                                <td>
                                    <div class="action-buttons" style="display: flex !important; gap: 8px !important; align-items: center !important;">
                                        <a href="/admin/navigation/edit/<%= nav.tenantId %>" class="btn btn-sm btn-edit" title="Edit Navigation" style="display: inline-flex !important; padding: 6px 10px !important; background: #10b981 !important; color: white !important; border-radius: 6px !important; text-decoration: none !important; font-size: 12px !important;">
                                            <span style="font-size: 14px;">✏️</span> Edit
                                        </a>
                                        <form method="POST" action="/admin/navigation/delete/<%= nav.tenantId %>" style="display: inline !important; margin: 0 !important;" onsubmit="return confirm('Are you sure you want to delete this navigation?');">
                                            <button type="submit" class="btn btn-sm btn-delete" title="Delete Navigation" style="display: inline-flex !important; padding: 6px 10px !important; background: #ef4444 !important; color: white !important; border-radius: 6px !important; border: none !important; cursor: pointer !important; font-size: 12px !important;">
                                                <span style="font-size: 14px;">🗑️</span> Delete
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        <% }); %>
                    <% } else { %>
                        <tr>
                            <td colspan="5" class="empty-state">
                                <% if (selectedTenantId) { %>
                                    No navigation configuration found for this tenant. <a href="/admin/navigation/edit/<%= selectedTenantId %>">Create one</a>
                                <% } else { %>
                                    No navigation configurations found. Select a tenant to create navigation.
                                <% } %>
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
    
    <footer class="admin-footer">
        <div>
            <span>© 2024 MicroSite Empire AI. All rights reserved.</span>
        </div>
        <div class="footer-links">
            <a href="/admin/dashboard">Dashboard</a>
            <a href="/api-docs" target="_blank">API Docs</a>
            <a href="#" onclick="alert('Version 1.0.0'); return false;">Version</a>
        </div>
    </footer>
</body>
</html>

